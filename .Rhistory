# set up the transition matrix and compute matrix entries
A <- matrix(NA,3,3)  # 2 x 2 transition matrix
A[1,1] <- (1-g)*s  # probability that a seed does not germinate and survives
A[2,1] <- g    # probability that a seed germinates, emerges and grows into a plant
A[3,1] <- 0 # probability that a seed becomes a reproductive adult
A[2,1] <- 0   # seeds produced by vegetative adults
A[2,2] <- 0   # probability that a plant survives (our annual plant model assumed this was zero)
A[2,3] <- 1 # probability that a plant reproduces
A[3,1] <- lambda # fecundity
A[3,2] <- 0 # probability that a reproductive individual becomes a vegetative individual
A[3,3] <- 0 # reproductive individuals die, not stay same
A
